      "label": "Job"
    },
    {
      "label": "Breaker"
    },
    {
      "label": "Source"
    },
    {
      "label": "Cache"
    }
  ],
  "nodes": [
    {
      "id": "job",
      "type": "backend",
      "label": "Ingest job",
      "sublabel": "scheduler",
      "stage": 0,
      "row": 1,
      "tag": "lock"
    },
    {
      "id": "cb",
      "type": "security",
      "label": "Breaker",
      "sublabel": "resilient_client",
      "stage": 1,
      "row": 1,
      "tag": "cooldown"
    },
    {
      "id": "http",
      "type": "external",
      "label": "Public source",
      "sublabel": "NVD etc",
      "stage": 2,
      "row": 1,
      "tag": "503"
    },
    {
      "id": "pg",
      "type": "database",
      "label": "Last-good",
      "sublabel": "PostgreSQL",
      "stage": 3,
      "row": 1,
      "tag": "stale ok"
    }
  ],
  "flows": [
    {
      "id": "j-c",
      "from": "job",
      "to": "cb",
