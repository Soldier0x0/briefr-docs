  "components": [
    { "id": "browser", "type": "frontend", "label": "Browser", "sublabel": "SPA", "row": 1, "col": 0 },
    { "id": "edge", "type": "cloud", "label": "Zero Trust", "sublabel": "optional edge", "row": 0, "col": 1 },
    { "id": "api", "type": "backend", "label": "FastAPI", "sublabel": "auth middleware", "row": 1, "col": 1 },
    { "id": "session", "type": "security", "label": "Session cookies", "sublabel": "briefr_at / rt", "row": 1, "col": 2 },
    { "id": "admin", "type": "security", "label": "Admin role", "sublabel": "is_admin DB", "row": 2, "col": 2 },
    { "id": "wallboard", "type": "security", "label": "Wallboard token", "sublabel": "header only", "row": 0, "col": 2 },
