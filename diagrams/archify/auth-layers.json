    { "id": "admin-db", "from": "admin", "to": "postgres", "label": "is_admin", "variant": "security" },
    { "id": "wall-api", "from": "wallboard", "to": "api", "variant": "dashed" }
  ],
  "cards": [
    {
      "dot": "rose",
